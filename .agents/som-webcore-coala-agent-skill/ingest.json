{
  "_doc": "Fontes do material do projeto para `coala.py sync`. rules: mode markdown|text|whole|pdf · type episodic|semantic|procedural · origin owner|agent|untrusted|system · tags aceitam {stem} {name} {dir} {rule}; a primeira regra que apanha um ficheiro ganha. code: o catálogo de código (símbolos por ficheiro) é automático — `include`/`exclude` são globs, `enabled: false` desliga. Ver references/instalar.md da coala-agent-skill.",
  "version": 2,
  "key_prefix": "som",
  "path_prefix": "",
  "exclude": [
    "docs/figures/**",
    ".github/**",
    ".agents/**",
    "*.pdf"
  ],
  "rules": [
    {
      "name": "readme",
      "include": [
        "README.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "docs,readme,manifesto,jev,arquitetura"
    },
    {
      "name": "planejamento",
      "include": [
        "ROADMAP.md",
        "docs/METHODOLOGY.md",
        "docs/STRUCTURE.md",
        "research/ERRATA.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "docs,roadmap,dag,metodologia,estrutura,errata,{stem}"
    },
    {
      "name": "pesquisa-arquitetura",
      "include": [
        "research/01-*.txt"
      ],
      "mode": "text",
      "type": "semantic",
      "origin": "untrusted",
      "tags": "research,webgpu,wasm32,arquitetura,pdf-fonte,{stem}"
    },
    {
      "name": "pesquisa-runtime",
      "include": [
        "research/02-*.txt"
      ],
      "mode": "text",
      "type": "semantic",
      "origin": "untrusted",
      "tags": "research,wgpu,wgsl,runtime,sombin,pdf-fonte,{stem}"
    },
    {
      "name": "pesquisa-capacidade",
      "include": [
        "research/03-*.md",
        "research/04-*.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "untrusted",
      "tags": "research,memoria,webgpu,decisions-api,modelos,capacidade,{stem}"
    },
    {
      "name": "governanca",
      "include": [
        "CONTRIBUTING.md",
        "GOVERNANCE.md",
        "SECURITY.md",
        "CODE_OF_CONDUCT.md",
        "CHANGELOG.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "docs,governanca,{stem}"
    },
    {
      "name": "decisoes",
      "include": [
        "docs/adr/*.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "docs,adr,decisao,bifurcacao,{stem}"
    },
    {
      "name": "relatorios",
      "include": [
        "docs/reports/*.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "docs,relatorio,medicao,{stem}"
    },
    {
      "name": "especificacao",
      "include": [
        "docs/spec/*.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "docs,spec,decisions-api,{stem}"
    },
    {
      "name": "padronizacao",
      "include": [
        "docs/standards/*.md"
      ],
      "mode": "markdown",
      "type": "semantic",
      "origin": "agent",
      "tags": "docs,padronizacao,prior-art,{stem}"
    },
    {
      "name": "bancada",
      "include": [
        "bench/spike-mobile/*.md"
      ],
      "mode": "markdown",
      "type": "procedural",
      "origin": "agent",
      "tags": "bench,bancada,procedimento,{stem}"
    }
  ],
