{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/frederico-kluser/som-webcore/models/catalog.schema.json",
  "title": "Catálogo de modelos do SOM WebCore",
  "description": "Cada modelo fixado por revisão e por SHA-256 de cada arquivo, com licença, origem, calibração, idiomas e a fonte datada da qualidade. Validado por tools/fetch_model.py --check (sem dependências).",
  "type": "object",
  "required": ["schemaVersion", "checked", "models"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "checked": { "$ref": "#/$defs/date" },
    "models": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/model" } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "spdx": { "type": "string", "pattern": "^[A-Za-z0-9.+-]+$" },
    "source": { "type": "string", "minLength": 1 },
    "model": {
      "type": "object",
      "required": ["id", "name", "repo", "revision", "architecture", "files", "license", "provenance", "calibration", "languages", "quality", "attribution"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "repo": { "type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$" },
        "revision": { "$ref": "#/$defs/revision" },
        "revisionDate": { "$ref": "#/$defs/date" },
        "architecture": {
          "type": "object",
          "required": ["family", "layers", "hidden", "maxTokens", "parameters", "source"],
          "additionalProperties": false,
          "properties": {
            "family": { "type": "string", "minLength": 1 },
            "layers": { "type": "integer", "minimum": 1 },
            "hidden": { "type": "integer", "minimum": 1 },
            "intermediate": { "type": "integer", "minimum": 1 },
            "heads": { "type": "integer", "minimum": 1 },
            "vocab": { "type": "integer", "minimum": 1 },
            "maxTokens": { "type": "integer", "minimum": 1 },
            "parameters": { "type": "integer", "minimum": 1 },
            "embeddingParameters": { "type": "integer", "minimum": 0 },
            "source": { "$ref": "#/$defs/source" }
          }
        },
        "files": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": ["size", "sha256", "role"],
            "additionalProperties": false,
            "properties": {
              "size": { "type": "integer", "minimum": 0 },
              "sha256": { "$ref": "#/$defs/sha256" },
              "role": { "enum": ["weights", "tokenizer", "config", "reference", "license", "card"] },
              "dtype": { "type": "string", "minLength": 1 },
              "lfs": { "type": "boolean" }
            }
          }
        },
        "license": {
          "type": "object",
          "required": ["spdx", "category", "source"],
          "additionalProperties": false,
          "properties": {
            "spdx": { "$ref": "#/$defs/spdx" },
            "category": {
              "description": "permissive: permite uso comercial e redistribuição; non-commercial: proíbe uso comercial; custom: termos próprios do autor, lidos caso a caso.",
              "enum": ["permissive", "non-commercial", "custom"]
            },
            "file": { "type": "string", "minLength": 1 },
            "source": { "$ref": "#/$defs/source" }
          }
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["repo", "relation", "license", "source"],
            "additionalProperties": false,
            "properties": {
              "repo": { "type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$" },
              "relation": { "type": "string", "minLength": 1 },
              "license": { "$ref": "#/$defs/spdx" },
              "revisionChecked": { "$ref": "#/$defs/revision" },
              "source": { "$ref": "#/$defs/source" }
            }
          }
        },
        "calibration": {
          "type": "object",
          "required": ["status", "source"],
          "additionalProperties": false,
          "properties": {
            "status": { "enum": ["calibrated", "uncalibrated", "unknown"] },
            "detail": { "type": "string" },
            "source": { "$ref": "#/$defs/source" }
          }
        },
        "languages": {
          "type": "object",
          "required": ["declared", "source"],
          "additionalProperties": false,
          "properties": {
            "declared": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$" } },
            "note": { "type": "string" },
            "source": { "$ref": "#/$defs/source" }
          }
        },
        "questionTypes": {
          "description": "Nome de cada tipo de pergunta da Decisions API no formato do modelo.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "boolean": { "type": "string" },
            "choice": { "type": "string" },
            "score": { "type": "string" }
          }
        },
        "quality": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["metric", "value", "label", "source", "date"],
            "additionalProperties": false,
            "properties": {
              "metric": { "type": "string", "minLength": 1 },
              "value": { "type": "number" },
              "label": { "enum": ["MEDIDO", "REPORTADO"] },
              "source": { "$ref": "#/$defs/source" },
              "date": { "$ref": "#/$defs/date" }
            }
          }
        },
        "attribution": { "type": "string", "minLength": 1 }
      }
    }
  }
}
